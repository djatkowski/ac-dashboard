{
  "//": "M5Stack Tab5 (ESP32-P4NRW32). The pioarduino platform has no entry for this board yet, so the project carries its own. Derived from esp32-p4_r3-evboard; changed: 32 MB PSRAM and the name.",
  "build": {
    "core": "esp32",
    "extra_flags": [
      "-DARDUINO_USB_CDC_ON_BOOT=1",
      "-DARDUINO_USB_MODE=1",
      "-DBOARD_HAS_PSRAM",
      "-DARDUINO_M5STACK_TAB5"
    ],
    "f_cpu": "400000000L",
    "f_flash": "80000000L",
    "f_psram": "200000000L",
    "flash_mode": "qio",
    "mcu": "esp32p4",
    "chip_variant": "esp32p4",
    "variant": "esp32p4"
  },
  "arduino": {
    "partitions": "default_16MB.csv"
  },
  "connectivity": [],
  "debug": {
    "openocd_target": "esp32p4.cfg"
  },
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "name": "M5Stack Tab5 (ESP32-P4, 32MB PSRAM)",
  "upload": {
    "flash_size": "16MB",
    "maximum_ram_size": 512000,
    "maximum_size": 16777216,
    "require_upload_port": true,
    "speed": 1500000
  },
  "url": "https://docs.m5stack.com/en/core/Tab5",
  "vendor": "M5Stack"
}
